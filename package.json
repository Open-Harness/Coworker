{
  "name": "pi-exp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && node scripts/check-build.ts",
    "start": "node scripts/serve.ts",
    "deploy:celld": "node scripts/deploy.ts",
    "typecheck": "tsc --noEmit && tsc -p packages/blueprint",
    "lint": "oxlint --ignore-pattern 'packages/orthograph/**'",
    "format": "oxfmt src scripts test live packages/blueprint *.ts",
    "format:check": "oxfmt --check src scripts test live packages/blueprint *.ts",
    "check:shape": "node scripts/check-shape.ts",
    "check:packages": "node scripts/check-packages.ts",
    "check:ui": "node scripts/check-ui.ts",
    "test": "vitest --run",
    "test:live": "vitest --run --config vitest.live.config.ts",
    "credentials": "node src/bin/credentials.ts",
    "staging": "node scripts/staging.ts",
    "staging:until-green": "node scripts/staging-until-green.ts",
    "live:sign-in": "node scripts/live-sign-in.ts",
    "db:generate": "drizzle-kit generate",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:shape && pnpm check:packages && pnpm check:ui && pnpm check:size && pnpm test",
    "check:size": "node scripts/check-size.ts",
    "climb": "node evals/climb/main.ts",
    "score": "node src/bin/score.ts",
    "dashboard:data": "node scripts/dashboard-data.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@heroicons/react": "2.2.0",
    "@octokit/webhooks-methods": "6.0.0",
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/store": "0.11.2",
    "better-auth": "^1.7.27",
    "drizzle-orm": "0.45.4",
    "partysocket": "1.3.0",
    "postal-mime": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@chat-adapter/slack": "4.44.0",
    "@chat-adapter/state-memory": "4.44.0",
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261123.1",
    "@octokit/webhooks-examples": "7.6.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "chat": "4.44.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "happy-dom": "^21.0.4",
    "oxfmt": "0.78.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
