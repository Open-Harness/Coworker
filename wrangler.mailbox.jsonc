{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The mailboxes of the live tier's two outside people, on the test domain (docs/live-setup.md). Not part of the product.
  // `pnpm staging --apply` fills the domain in, deploys it, sets its secret MAILBOX_TOKEN and routes the two addresses to it.
  "name": "coworker-mailbox",
  "main": "src/bin/mailbox.ts",
  "compatibility_date": "2026-09-23",
  "routes": [{ "pattern": "mailbox.co-worker.tech", "custom_domain": true }],
  "vars": { "MAILBOX_DOMAIN": "co-worker.tech" },
  "durable_objects": { "bindings": [{ "name": "BOXES", "class_name": "MailboxObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailboxObject"] }],
  "send_email": [{ "name": "EMAIL" }]
}
