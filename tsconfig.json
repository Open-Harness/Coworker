{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "isolatedModules": true,
    "types": ["vite/client", "node", "@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src", "test", "scripts", "e2e", "live", "*.ts"]
}
