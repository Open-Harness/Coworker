# Copy to .env. Every line is optional, but without a model provider nobody can answer.

# Model providers. Any combination works; people pick among what is offered.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# An OpenAI-compatible proxy such as VibeProxy, and what to offer from it (comma-separated).
PI_EXP_PROXY_URL=http://127.0.0.1:8317
PI_EXP_PROXY_MODELS=gpt-6-luna
PI_EXP_PROXY_KEY=

# What new workspaces start with, as provider/model. Default: the first one offered.
PI_EXP_DEFAULT_MODEL=

# Tailscale logins that see the admin view, comma-separated. Empty: everyone does.
PI_EXP_ADMINS=
